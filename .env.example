# Copia este archivo a .env y ajusta los valores. No contiene secretos reales:
# las credenciales son solo para la base de datos local de Docker Compose.

# --- PostgreSQL (servicio db) ---
POSTGRES_USER=mantenimiento
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_DB=mantenimiento
# Puerto publicado en el host. Cámbialo si ya tienes otro PostgreSQL en el 5432.
POSTGRES_PORT=5432

# --- Backend ---
# Docker Compose construye la URL del backend con las variables POSTGRES_* y el host "db".
# DATABASE_URL solo se usa al ejecutar el backend, Alembic o las pruebas fuera de Docker,
# contra el PostgreSQL de Compose publicado en localhost:POSTGRES_PORT.
DATABASE_URL=postgresql+psycopg://mantenimiento:cambia-esta-clave-local@localhost:5432/mantenimiento
# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173
# Zona de operación para fechas de trabajo, horas mostradas y año del número de avería.
OPERATION_TIMEZONE=Europe/Madrid
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173
